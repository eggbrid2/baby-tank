static const baby_tank_food_sprite_t *baby_tank_food_sprite_for_expression(
    baby_tank_expression_t expression)
{
    switch (expression) {
    case BABY_TANK_EXPRESSION_STRAWBERRY: return &s_food_strawberry;
    case BABY_TANK_EXPRESSION_APPLE: return &s_food_apple;
    case BABY_TANK_EXPRESSION_BANANA: return &s_food_banana;
    case BABY_TANK_EXPRESSION_CAKE: return &s_food_cake;
    case BABY_TANK_EXPRESSION_COOKIE: return &s_food_cookie;
    case BABY_TANK_EXPRESSION_BREAD: return &s_food_bread;
    case BABY_TANK_EXPRESSION_RICE_BALL: return &s_food_rice_ball;
    case BABY_TANK_EXPRESSION_ICE_CREAM: return &s_food_ice_cream;
    case BABY_TANK_EXPRESSION_MILK: return &s_food_milk;
    case BABY_TANK_EXPRESSION_JUICE: return &s_food_juice;
    case BABY_TANK_EXPRESSION_WATER: return &s_food_water;
    case BABY_TANK_EXPRESSION_YOGURT: return &s_food_yogurt;
    case BABY_TANK_EXPRESSION_SOY_MILK: return &s_food_soy_milk;
    case BABY_TANK_EXPRESSION_COCOA: return &s_food_cocoa;
    default: return NULL;
    }
}
